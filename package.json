{
  "name": "@vargamesh/wallet-sdk",
  "version": "0.1.0-alpha.1",
  "description": "Reference wallet integration SDK for the VargaMesh (VMESH) mainnet",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "test-vectors",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
