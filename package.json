    "wallet",
    "utxo",
    "segwit",
    "secp256k1"
  ],
  "license": "MIT",
  "types": "./src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/ati1993de/vargamesh-wallet-sdk.git"
  },
  "homepage": "https://vargacoin.com/",
  "bugs": {
    "url": "https://github.com/ati1993de/vargamesh-wallet-sdk/issues"
  }
